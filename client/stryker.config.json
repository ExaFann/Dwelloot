{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "Mutation testing. Always scope a run to the changed files (--mutate); a full run takes hours. See .claude/skills/mutation-check.",
  "testRunner": "vitest",
  "vitest": { "configFile": "vitest.stryker.config.ts", "related": false },
  "coverageAnalysis": "all",
  "incremental": true,
  "reporters": ["json", "html", "progress"],
  "thresholds": { "high": 80, "low": 60, "break": null }
}
