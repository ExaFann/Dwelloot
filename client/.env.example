# Copy to .env.production (or set in the host's build environment) before building for deployment.
# Task [60] sets this to the deployed backend's origin. No trailing slash.
# Without this, the build still succeeds but the app THROWS ON LOAD and renders nothing.
# The build also prints a warning. See src/api/config.ts.
VITE_API_BASE_URL=https://your-backend.example.com
